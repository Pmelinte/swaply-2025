# =============================================================================
# Swaply 2025 - Environment Variables
# =============================================================================
# For LOCAL development: copy this file to .env.local and fill in the values.
# For VERCEL deployment: add these in Vercel Dashboard → Settings → Environment Variables.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# --- Supabase (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (unsigned uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- HuggingFace AI ---
NEXT_PUBLIC_HF_ENABLED=true
HUGGINGFACE_API_KEY=

# --- Google Maps ---
NEXT_PUBLIC_MAPS_TOKEN=

# --- Groq LLM (AI classification & matching) ---
GROQ_API_KEY=

# --- Gemini LLM (fallback AI) ---
GEMINI_API_KEY=

# --- Push Notifications (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_KEY=

# --- Stripe Payments ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PLATINUM_MONTHLY=
STRIPE_PRICE_PLATINUM_YEARLY=

# --- PayPal Payments ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Options: sandbox, live
PAYPAL_MODE=sandbox

# --- Courier Services (Romania) ---
FANCOURIER_CLIENT_ID=
FANCOURIER_USERNAME=
FANCOURIER_PASSWORD=
SAMEDAY_API_KEY=
SAMEDAY_API_URL=
CARGUS_API_KEY=
# Markup percentage added to courier costs (default: 8)
COURIER_MARKUP_PERCENT=8

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ads (optional) ---
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_CARBON_SERVE=

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=

# --- Logging ---
# Options: debug, info, warn, error
LOG_LEVEL=info

# --- Analytics ---
ANALYTICS_ENDPOINT=

# --- Runtime ---
# Options: development, production, test
NODE_ENV=development
