# =============================================================================
# Swaply 2025 - Environment Variables
# =============================================================================
# For LOCAL development: copy this file to .env.local and fill in the values.
# For VERCEL deployment: add these in Vercel Dashboard → Settings → Environment Variables.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# --- Supabase (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (unsigned uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- HuggingFace AI (classification + semantic embeddings) ---
# Used for image/text classification AND vector embeddings (all-MiniLM-L6-v2, 384d)
# Embeddings power the pgvector semantic matching system
NEXT_PUBLIC_HF_ENABLED=true
HUGGINGFACE_API_KEY=
# Optional override for the Vision Gateway fallback.
HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct:fastest

# --- Google Maps ---
NEXT_PUBLIC_MAPS_TOKEN=

# --- Groq LLM (AI classification & matching) ---
GROQ_API_KEY=
# Current multimodal default; keep configurable to survive provider deprecations.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Gemini LLM (fallback AI) ---
GEMINI_API_KEY=
# Stable multimodal fallback; do not use the retired gemini-2.0-flash model.
GEMINI_VISION_MODEL=gemini-3.6-flash

# --- xAI / Grok Vision (AI image analysis for listing wizard) ---
XAI_API_KEY=

# --- Push Notifications (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Stripe Payments ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PLATINUM_MONTHLY=
STRIPE_PRICE_PLATINUM_YEARLY=

# --- PayPal Payments ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Options: sandbox, live
PAYPAL_MODE=sandbox

# --- Courier Services (Romania) ---
FANCOURIER_CLIENT_ID=
FANCOURIER_USERNAME=
FANCOURIER_PASSWORD=
SAMEDAY_API_KEY=
SAMEDAY_API_URL=
CARGUS_API_KEY=
# Markup percentage added to courier costs (default: 8)
COURIER_MARKUP_PERCENT=8

# --- Courier Services (Per-Country — see src/lib/payments/country-registry.ts) ---
# Each country uses env vars with provider-specific prefixes.
# Examples for expansion to other markets:
# Germany: DHL_PAKET_API_KEY, HERMES_API_KEY, DPD_DE_API_KEY, GLS_DE_API_KEY
# France: COLISSIMO_API_KEY, CHRONOPOST_API_KEY, MONDIAL_RELAY_API_KEY
# UK: ROYAL_MAIL_API_KEY, EVRI_API_KEY, DPD_UK_API_KEY
# Poland: INPOST_API_KEY, POCZTA_PL_API_KEY, DPD_PL_API_KEY
# Netherlands: POSTNL_API_KEY, DPD_NL_API_KEY
# Spain: CORREOS_API_KEY, SEUR_API_KEY, MRW_API_KEY
# Italy: POSTE_IT_API_KEY, BRT_API_KEY, GLS_IT_API_KEY
# USA: USPS_API_KEY, UPS_API_KEY, FEDEX_API_KEY

# --- DHL Express (International Shipping) ---
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
# Options: https://express.api.dhl.com/mydhlapi (production), https://express.api.dhl.com/mydhlapi/test (sandbox)
DHL_API_URL=https://express.api.dhl.com/mydhlapi/test

# --- Escrow (Secure Swap Transactions) ---
ESCROW_API_KEY=
ESCROW_API_EMAIL=
# Options: https://api.escrow.com/2017-09-01 (production), https://api.escrow-sandbox.com/2017-09-01 (sandbox)
ESCROW_API_URL=https://api.escrow-sandbox.com/2017-09-01

# --- Accommodation Affiliates (House Swaps) ---
BOOKING_AFFILIATE_ID=
AIRBNB_AFFILIATE_ID=
VRBO_AFFILIATE_ID=

# --- Flight Tickets ---
KIWI_API_KEY=
KIWI_AFFILIATE_ID=
SKYSCANNER_AFFILIATE_ID=

# --- Car Rental Affiliates ---
RENTALCARS_AFFILIATE_ID=
DISCOVERCARS_AFFILIATE_ID=
AUTOEUROPE_AFFILIATE_ID=

# --- Ground Transport Affiliates ---
FLIXBUS_AFFILIATE_ID=
OMIO_AFFILIATE_ID=
BLABLACAR_AFFILIATE_ID=

# --- Insurance ---
XCOVER_API_KEY=
XCOVER_PARTNER_ID=
# Options: https://api.xcover.com/api/v2 (production), sandbox URL
XCOVER_API_URL=
ALLIANZ_AFFILIATE_ID=

# --- Packaging ---
EMAG_AFFILIATE_ID=
PACKAGING_PARTNER_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Swaply <noreply@swaply.world>

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ads (optional) ---
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_CARBON_SERVE=

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=

# --- Logging ---
# Options: debug, info, warn, error
LOG_LEVEL=info

# --- Analytics ---
ANALYTICS_ENDPOINT=

# --- E2E Testing (Playwright) ---
# Pre-existing Supabase user for authenticated E2E tests
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# --- Runtime ---
# Options: development, production, test
NODE_ENV=development
