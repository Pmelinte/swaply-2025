      "lineHeight": 1.25
    },
    {
      "id": "vG8k9E1CxxEbYlk3wI0Me",
      "type": "text",
      "x": 1452.1389179162761,
      "y": 1986.5213783237225,
      "width": 300.61408493120445,
      "height": 15.165385672681527,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
