      "versionNonce": 1428521326,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766616165425,
      "link": null,
      "locked": false,
      "text": "În schema actuală există mesajul general “completează mai mult = matching mai bun”, dar nu există o secțiune\nconcretă de tip:",
      "fontSize": 6.0661542690726105,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "În schema actuală există mesajul general “completează mai mult = matching mai bun”, dar nu există o secțiune concretă de tip:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "CWSEUNTIiqAEJgwbtDU5d",
      "type": "text",
      "x": 1452.1389179162761,
      "y": 1967.5646462328707,
      "width": 228.46328622683592,
      "height": 7.5826928363407635,
      "angle": 0,
