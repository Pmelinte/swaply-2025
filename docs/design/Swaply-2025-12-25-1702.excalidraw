      "seed": 1965893362,
      "version": 149,
      "versionNonce": 604971950,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766616165425,
      "link": null,
      "locked": false,
      "text": "„Ce știe AI despre obiectul meu?” (etichete, categorie sugerată, scoruri, interpretare)",
      "fontSize": 6.0661542690726105,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "„Ce știe AI despre obiectul meu?” (etichete, categorie sugerată, scoruri, interpretare)",
