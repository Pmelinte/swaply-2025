      "versionNonce": 571112942,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766616165425,
      "link": null,
      "locked": false,
      "text": "„Ce lipsește ca să primesc potriviri mai bune?” (ex: fără imagine, fără subcategorie, fără valoare percepută, fără\ncontext etc.)",
      "fontSize": 6.0661542690726105,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "„Ce lipsește ca să primesc potriviri mai bune?” (ex: fără imagine, fără subcategorie, fără valoare percepută, fără context etc.)",
      "autoResize": false,
      "lineHeight": 1.25
    },
