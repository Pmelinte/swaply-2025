      "versionNonce": 1813784686,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766616165425,
      "link": null,
      "locked": false,
      "text": "Mai apare undeva o mențiune de tip “condiție acceptată (opțional)” la “dorit”, dar nu e transformată în câmp\nclar pe Obiect detail.",
      "fontSize": 6.0661542690726105,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mai apare undeva o mențiune de tip “condiție acceptată (opțional)” la “dorit”, dar nu e transformată în câmp clar pe Obiect detail.",
