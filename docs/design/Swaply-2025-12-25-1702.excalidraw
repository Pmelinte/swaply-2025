      "verticalAlign": "top",
      "containerId": null,
      "originalText": "În schemă apare “stare” în sens de Activ/Inactiv (publicare), dar nu apare clar condiția fizică (nou/folosit/uzat/de reparat etc.) ca input pe Obiect.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "86h-MJ_DOb-zRLin5qE-C",
      "type": "text",
      "x": 1452.1389179162761,
      "y": 1850.0329072695888,
      "width": 292.33386673425025,
      "height": 15.165385672681527,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
